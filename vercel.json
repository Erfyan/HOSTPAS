{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/build/assets/(.*)",
      "dest": "/public/build/assets/$1"
    },
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/(.*)\\.(ico|css|js|gif|jpg|jpeg|png|svg|woff|woff2|ttf|eot)$",
      "dest": "/public/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "env": {
    "APP_NAME": "HOSTPAS",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://hostpas.vercel.app",
    "ASSET_URL": "https://hostpas.vercel.app",
    "APP_KEY": "base64:yKwyqceWgR4RhX1oXRz9KvRPtesoAo408zpUYjaCQuo=",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp/views",
    "CACHE_STORE": "array",
    "CACHE_DRIVER": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr",
    "DB_CONNECTION": "pgsql",
    "DB_HOST": "aws-0-us-east-1.pooler.supabase.com",
    "DB_PORT": "6543",
    "DB_DATABASE": "postgres",
    "DB_USERNAME": "postgres.wvopxqhdvrcqozfbelak",
    "DB_PASSWORD": "hostpas2026",
    "DB_SSLMODE": "require",
